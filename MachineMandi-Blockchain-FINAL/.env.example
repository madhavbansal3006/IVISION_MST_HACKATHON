# ==============================================================================
# MachineMandi Blockchain Environment Variables (Example Template)
# ==============================================================================
# DO NOT COMMIT REAL PRIVATE KEYS TO VERSION CONTROL.
# Sourced dynamically by Hardhat scripts when interacting with MST Testnet.
# ==============================================================================

# MST Testnet RPC Endpoint
MST_RPC_URL=https://testnet-rpc.mstscan.com

# MST Testnet Chain ID (91562037 / 0x57530cd)
MST_CHAIN_ID=91562037

# MST Block Explorer URL
MST_EXPLORER_URL=https://testnet.mstscan.com

# Deployer / Relayer Account Private Key (Hex without 0x or with 0x)
# Must hold native MST for transaction gas fees
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
