{
  "name": "machinemandi-blockchain",
  "version": "1.0.0",
  "description": "MachineMandi decentralized machine-to-machine escrow protocol and MST Testnet integration",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "chain:check": "hardhat run scripts/checkNetwork.ts",
