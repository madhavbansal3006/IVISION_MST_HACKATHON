# Server Configuration
PORT=3000
NODE_ENV=development

# Validation Rules
REQUIRE_MOISTURE_INCREASE=false
MAX_FUTURE_DRIFT_SECONDS=3600

# Blockchain Relayer Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=100

# Blockchain Adapter Mode (default: mock, set to 'live' for real MST)
BLOCKCHAIN_ADAPTER_MODE=mock

# Blockchain Configuration (MST Testnet)
# NOTE: These values come exclusively from environment variables.
# When BLOCKCHAIN_ADAPTER_MODE=mock, the backend runs seamlessly without live credentials.
# Under NO circumstances should device private keys ever be stored here.
MST_RPC_URL=https://testnet-rpc.mstscan.com
MST_CHAIN_ID=91562037
MACHINE_MANDI_CONTRACT_ADDRESS=0xac7F286057238bA05CC878A2d71dF265Fa1e9EEE
RELAYER_PRIVATE_KEY=

# Demo Device Simulator (Node #1 Private Key)
# NOTE: Required only when running the local demo device simulator (npm run demo:proof).
# For proof verification to succeed, this private key must correspond to the
# registered Node #1 signer address: 0xAa0A3DC02cDc7d5e2d108DabD096C1822bc0E8b8
# NEVER commit or expose the actual private key.
DEMO_DEVICE_PRIVATE_KEY=

