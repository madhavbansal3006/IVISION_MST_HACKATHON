# MachineMandi Frontend Configuration (Public / Non-Secret Only)
# Do NOT put private keys or sensitive credentials in this file or any frontend environment variable.

# Backend Service URL (defaults to http://localhost:3000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# MST Testnet RPC URL (defaults to https://testnetrpc.mstblockchain.com)
NEXT_PUBLIC_MST_RPC_URL=https://testnetrpc.mstblockchain.com

# MachineMandi Deployed Smart Contract (defaults to 0xac7F286057238bA05CC878A2d71dF265Fa1e9EEE)
NEXT_PUBLIC_MACHINE_MANDI_CONTRACT_ADDRESS=0xac7F286057238bA05CC878A2d71dF265Fa1e9EEE
